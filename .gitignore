/apk/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# Raw handoff / Fable export (design source material, kept out of the repo)
.input/

# Obsolete web build config (kept locally, not for RN)
ecosystem.config.cjs

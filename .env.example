# Public Mapbox token (pk.*) — used at runtime by the app (map tiles,
# Directions API). Same account/token as reca-operator's VITE_MAPBOX_TOKEN
# can be reused. Read via `process.env.EXPO_PUBLIC_MAPBOX_TOKEN` — the
# EXPO_PUBLIC_ prefix is Expo's convention for vars safe to inline in the JS
# bundle. Without it, the map fails to load tiles (never crashes).
EXPO_PUBLIC_MAPBOX_TOKEN=""

# Secret Mapbox token (sk.*) with the "Downloads:Read" scope — needed ONLY
# on the machine that builds the native app (laptop, via `expo prebuild` +
# Android Studio / Gradle). It authenticates downloading the Mapbox native
# SDK from Maven and is read directly from the shell environment at build
# time (System.getenv('RNMAPBOX_MAPS_DOWNLOAD_TOKEN')) — never bundled into
# the app, never needed to write or typecheck code on the dev server.
# Create it at https://account.mapbox.com/access-tokens (new token, check
# "Downloads:Read" under Secret scopes).
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=""

# Supabase project shared with RECA App (same account/project as
# reca-app's VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY — do not create a
# separate project). Anon key only: RLS on `missions`/`mission_items`
# scopes writes to the authenticated operator (employees.user_id ->
# missions.operator_id), see src/integrations/supabase/. Read via
# `process.env.EXPO_PUBLIC_SUPABASE_URL`/`EXPO_PUBLIC_SUPABASE_ANON_KEY`.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
